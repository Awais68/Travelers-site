# Static caching hints for Netlify / Cloudflare Pages (ignored by hosts that
# don't read _headers; set the equivalents in nginx/CDN config there instead).

# Vite emits content-hashed filenames into /assets — safe to cache forever.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Optimised hero images (stable names) — cache a month, revalidate after.
/images/*
  Cache-Control: public, max-age=2592000
  Vary: Accept

/favicon.svg
  Cache-Control: public, max-age=604800

# Security + correctness headers for every response.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
